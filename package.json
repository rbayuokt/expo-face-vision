{
  "name": "@rbayuokt/expo-face-vision",
  "version": "0.1.0",
  "description": "Native-first face detection, tracking, head pose, guidance and auto capture for Expo. Google ML Kit on Android, Apple Vision on iOS, Skia overlays.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "node internal/module_scripts/test.js",
    "example:ios": "npm install --prefix example && npm --prefix example run ios",
    "example:android": "npm install --prefix example && npm --prefix example run android",
    "example:prebuild": "npm --prefix example run prebuild",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "face detection",
    "face tracking",
    "face landmarks",
    "head pose",
    "head gesture",
    "blink detection",
    "auto capture",
    "selfie",
    "liveness guidance",
    "mlkit",
    "vision",
    "skia",
    "react-native",
    "expo",
    "expo-modules",
    "ios",
    "android",
    "expo-face-vision",
    "ExpoFaceVision"
  ],
  "repository": "https://github.com/rbayuokt/expo-face-vision",
  "bugs": {
    "url": "https://github.com/rbayuokt/expo-face-vision/issues"
  },
  "author": "rbayuokt <rizkybayuoktavian@gmail.com> (https://github.com/rbayuokt)",
  "license": "MIT",
  "homepage": "https://github.com/rbayuokt/expo-face-vision#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@shopify/react-native-skia": "^2.4.18",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^55.0.31",
    "expo-haptics": "~55.0.18",
    "expo-speech": "~55.0.18",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "~4.2.1",
    "react-native-worklets": "~0.7.4",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "expo": "*",
    "expo-speech": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4.0.0",
    "expo-haptics": "*"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./overlays": {
      "types": "./build/overlays/index.d.ts",
      "default": "./build/overlays/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
